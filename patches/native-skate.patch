+ pub fn host_load_marker(&mut self,frame:[f32;16],onboard:bool,foot_forward:bool)->Result<Pose,String>{
+  let m=Mat4::from_cols_array(&frame);
+  if !m.is_finite()||m.determinant().abs()<0.5{return Err("Invalid native marker frame".into());}
+  let mut t=m.to_cols_array_2d();t[3][3]=0.;
+  self.input=ControllerInput::default();self.markers.suspend();
+  self.skater.player_input.request_teleport(t)?;
+  self.skater.teleport_state.request_manual(t,onboard);
+  self.skater.animation.restore_foot_forward(foot_forward);
+  for i in 0..12{
+   self.tick(Controls::default())?;
+   let state=self.host_state_id();if i>=3&&state==if onboard{100}else{500}{break;}
+  }
+  if self.host_state_id()!=if onboard{100}else{500}{return Err(format!("Marker reset did not settle: {}",self.host_state_id()));}
+  self.input=ControllerInput::default();Ok(self.pose())
+ }
+}
