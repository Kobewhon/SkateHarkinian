+impl Session {
+ /// One host-authorized near-landing impulse. No pose/animation reset,
+ /// teleport, score event, or board possession transition is performed.
+    pub fn host_legacy_pop(&mut self) -> Result<(), String> {
+        let state = self.host_state_id();
+        if !(200..=202).contains(&state) {
+            return Err("Legacy pop requires native airborne board ownership".into());
+        }
+        let mut velocity = self.host_trajectory().1;
+        velocity[1] += 18.;
+        super::player_state::host_enter_air(&mut self.physics, &mut self.skater)?;
+        for body in self.physics.board.bodies_mut() {
+            body.rates.linear_velocity.y += 18.;
+        }
+        self.physics.board.hook_mut().body.rates.linear_velocity.y += 18.;
+        for body in self.skater.skeleton.bodies_mut() {
+            body.rates.linear_velocity.y += 18.;
+        }
+        self.skater.trajectory.host_clear_prediction();
+        self.skater.player_input.processed.vectors_544_560_592_608[3] =
+            [velocity[0], velocity[1], velocity[2], 0.].map(f32::to_bits);
+        self.skater.air_state.use_centre_of_mass_velocity = true;
+        self.skater.air_state.trajectory_query_countdown = 0;
+        self.skater.air_state.centre_of_mass_trajectory.velocity = [velocity[0], velocity[1], velocity[2], 0.];
+        self.skater.animated_skeleton.motion.velocity_world = [velocity[0], velocity[1], velocity[2], 0.];
+        let deck = super::solve::deck_frame(&self.physics.board);
+        let parts = self.skater.skeleton.part_transforms();
+        let step = self.physics.settings.step.simulation.time_step;
+        for i in 0..parts.len() {
+            let p = if i == 0 { deck[3] } else { parts[i][3] };
+            self.skater.skeleton.record.positions[i] = [
+                p[0] - velocity[0] * step,
+                p[1] - velocity[1] * step,
+                p[2] - velocity[2] * step,
+                p[3],
+            ];
+        }
+        self.skater.skeleton.publish_physical_record(deck);
+        for i in 0..parts.len() {
+            self.skater.skeleton.record.velocities[i] = [velocity[0], velocity[1], velocity[2], 0.];
+            self.skater.skeleton.record.velocity_changes[i] = [0.; 4];
+        }
+        let frames = &mut self.skater.animated_skeleton.board_frames;
+        frames.centre_of_mass = self.skater.skeleton.record.centre_of_mass;
+        frames.previous_centre_of_mass = [
+            frames.centre_of_mass[0] - velocity[0] * step,
+            frames.centre_of_mass[1] - velocity[1] * step,
+            frames.centre_of_mass[2] - velocity[2] * step,
+            frames.centre_of_mass[3],
+        ];
+        frames.centre_of_mass = frames.previous_centre_of_mass;
+        frames.com_velocity = [velocity[0], velocity[1], velocity[2], 0.];
+        self.skater.air_state.centre_of_mass_trajectory.position = self.skater.skeleton.record.centre_of_mass;
+        self.physics.riding.motion = skate_core::physics::board_motion_output::BoardMotionOutput::from_board(
+            &self.physics.board,
+            self.physics.riding.reckoning.ground_normal,
+            self.skater.player_input.processed.flags_2468,
+        );
+        super::skeleton_feedback::publish(&self.physics, &mut self.skater, false);
+        self.skater.player_input.publish_board(&self.physics.riding)?;
+        self.skater.player_input.processed.vectors_544_560_592_608[3] =
+            [velocity[0], velocity[1], velocity[2], 0.].map(f32::to_bits);
+        self.skater.player_input.processed.vectors_400_416[0] =
+            [velocity[0], velocity[1], velocity[2], 0.].map(f32::to_bits);
+        let compression = self.skater.skeleton_output.average_compressions(&self.physics.board);
+        super::render_pose::publish(&self.physics, &mut self.skater, compression)?;
+        Ok(())
+    }
+}
