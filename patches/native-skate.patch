+impl Session {
+    pub fn host_link_clearance_height(&mut self, height: f32) -> Result<(), String> {
+        if !height.is_finite() || height < 0. || height > 2.5 {
+            return Err("Invalid rider-only clearance height".into());
+        }
+        let source = self.pose();
+        let head = source
+            .names
+            .iter()
+            .position(|n| n.eq_ignore_ascii_case("HEAD"))
+            .ok_or("Missing head rest")?;
+        let foot = source
+            .names
+            .iter()
+            .position(|n| n.eq_ignore_ascii_case("LEFTFOOT"))
+            .ok_or("Missing foot rest")?;
+        let native_height = (self.rest_bones[head].w_axis.y - self.rest_bones[foot].w_axis.y).abs();
+        if native_height < 0.5 {
+            return Err("Invalid stock rider rest height".into());
+        }
+        self.skater.host_clearance_scale = if height == 0. {
+            1.
+        } else {
+            (height / native_height).clamp(0.3, 1.)
+        };
+        self.skater.host_clearance_height = height;
+        Ok(())
+    }
+}
