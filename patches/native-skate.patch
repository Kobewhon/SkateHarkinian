+ /// teleport owns attachment/state reset; clear rates AND derivative histories
+ /// afterwards so neither physics nor pose publication retains water momentum.
+ pub fn host_water_return(&mut self,frame:[f32;16],onboard:bool,foot_forward:bool)->Result<Pose,String>{
