+// Original adapter entry point: collect physical samples at host cadence, then
+// publish once at the source simulation boundary. No intermediate tick occurs.
+impl Session {
+    pub fn host_tick_samples(&mut self, samples: &[Controls]) -> Result<(), String> {
+        // Native history has 30 slots and no full/empty distinction. A complete
+        // wrap before publication looks empty. Retain its newest 29 records; the
+        // original consumer deliberately publishes only the newest raw record.
+        let kept = &samples[samples
+            .len()
+            .saturating_sub(skate_core::input::history::HISTORY_CAPACITY - 1)..];
+        for (number, input) in kept.iter().enumerate() {
+            self.input.collect([
+                Ok(crate::input::platform::DevicePacket {
+                    number: number as u32,
+                    subtype: 1,
+                    state: skate_core::input::xbox::XboxState {
+                        buttons: input.buttons,
+                        triggers: input.triggers,
+                        left: input.left,
+                        right: input.right,
+                    },
+                }),
+                Err(crate::input::platform::DeviceError::Disconnected),
+                Err(crate::input::platform::DeviceError::Disconnected),
+                Err(crate::input::platform::DeviceError::Disconnected),
+            ]);
+        }
+        self.advance()
+    }
+}
