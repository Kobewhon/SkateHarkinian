+impl Session {
+ // Explicit host handoff: native reset initializes constraints, then incoming
+ // momentum is assigned to all coupled bodies, never only the deck.
+ pub fn host_activate_motion(&mut self,spawn:[f32;3],heading:f32,velocity:[f32;3])->Result<Pose,String>{
+    self.activate(spawn,heading)?;
+    let v=skate_core::math::Vector3::new(velocity[0],velocity[1],velocity[2]);
+    let current=self.physics.board.bodies()[skate_core::physics::board::BodyId::Deck.index()].rates.linear_velocity;
+    let delta=skate_core::math::Vector3::new(v.x-current.x,v.y-current.y,v.z-current.z);
+    let shift=|rate:&mut skate_core::math::Vector3|{rate.x+=delta.x;rate.y+=delta.y;rate.z+=delta.z;};
+    for body in self.physics.board.bodies_mut(){shift(&mut body.rates.linear_velocity);}
+    shift(&mut self.physics.board.hook_mut().body.rates.linear_velocity);
+    for body in self.skater.skeleton.bodies_mut(){shift(&mut body.rates.linear_velocity);}
+    // Native external momentum handoff publishes these SAME velocity fields;
+    // setting solver bodies alone leaves contradictory animation/PhysIn data.
+    self.skater.animated_skeleton.motion.velocity_world=[v.x,v.y,v.z,0.];
+    self.skater.player_input.processed.vectors_544_560_592_608[3]=[v.x,v.y,v.z,0.].map(f32::to_bits);
+    // The source consumes pose-derived velocities, not only body rates.
+    // Seed derivative HISTORY for the already-moving external owner, then
+    // republish through its actual producers without moving any physical body.
+    let step=self.physics.settings.step.simulation.time_step;
+    let parts=self.skater.skeleton.part_transforms();
+    let deck=super::solve::deck_frame(&self.physics.board);
+    for i in 0..parts.len(){
+      let point=if i==0{deck[3]}else{parts[i][3]};
+      let rate=if i==0{v}else{self.skater.skeleton.bodies()[i].rates.linear_velocity};
+      self.skater.skeleton.record.positions[i]=[point[0]-rate.x*step,point[1]-rate.y*step,point[2]-rate.z*step,point[3]];
+    }
+    self.skater.skeleton.publish_physical_record(deck);
+    let com=self.skater.skeleton.record.centre_of_mass;
+    let cv=self.skater.skeleton.record.centre_of_mass_velocity;
+    self.skater.animated_skeleton.board_frames.centre_of_mass=std::array::from_fn(|i|com[i]-cv[i]*step);
+    self.physics.riding.motion=skate_core::physics::board_motion_output::BoardMotionOutput::from_board(&self.physics.board,self.physics.riding.reckoning.ground_normal,self.skater.player_input.processed.flags_2468);
+    super::skeleton_feedback::publish(&self.physics,&mut self.skater,false);
+    self.skater.player_input.publish_board(&self.physics.riding)?;
+    let compression=self.skater.skeleton_output.average_compressions(&self.physics.board);
+    super::render_pose::publish(&self.physics,&mut self.skater,compression)?;
+    Ok(self.pose())
+ }
+}
