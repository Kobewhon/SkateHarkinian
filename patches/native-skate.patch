+  self.physics.board.hook_mut().body.rates.angular_velocity=skate_core::math::Vector3::ZERO;
+  for body in self.skater.skeleton.bodies_mut(){body.rates.linear_velocity=skate_core::math::Vector3::ZERO;body.rates.angular_velocity=skate_core::math::Vector3::ZERO;}
