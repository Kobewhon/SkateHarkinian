+// Original host integration diagnostic: stop at the FIRST invalid frame before
+// corrupt force/target data reaches the shared solver. Does not alter formulas.
+fn host_validate_frames(stage: &str, physics: &GamePhysics, skater: &SkaterRuntime) -> Result<(), String> {
+    let root = &skater.animated_skeleton.roots.animation_to_world;
+    let system = &physics.riding.reckoning_frames.system;
+    let ground = &physics.riding.reckoning_frames.ground;
+    // These are retail affine SIMD columns, not homogeneous Mat4 columns.
+    // W is a stored scratch lane (identity W is zero); native_matrix explicitly
+    // consumes XYZ and supplies homogeneous W. Reject meaningful geometry only.
+    if !host_affine_finite(root) || !host_affine_finite(system) || !host_affine_finite(ground) {
+        return Err(format!(
+            "Host frame diagnostic tick={} stage={} state={:?} root={:?} system={:?} ground={:?} up={:?} ground_normal={:?} heading={:?} body_flip={:?} board={:?}",
+            physics.ticks,
+            stage,
+            skater.player_state.current(),
+            root,
+            system,
+            ground,
+            physics.riding.reckoning.up,
+            physics.riding.reckoning.ground_normal,
+            physics.riding.reckoning_frames.heading,
+            physics.riding.reckoning_frames.body_flip,
+            physics.board.part_transforms()[BodyId::Deck.index()]
+        ));
+    }
+    Ok(())
+}
+
+fn host_affine_finite(frame:&[[f32;4];4])->bool {frame.iter().all(|column|column[..3].iter().all(|v|v.is_finite()))}
+#[cfg(test)] mod host_frame_validation_tests {
+ #[test] fn affine_scratch_lane_is_not_geometry(){
+  let mut frame=[[0.;4];4];frame[0][0]=1.;frame[1][1]=1.;frame[2][2]=1.;
+  frame[3][3]=f32::INFINITY;assert!(super::host_affine_finite(&frame));
+  frame[3][3]=f32::NEG_INFINITY;assert!(super::host_affine_finite(&frame));
+  frame[3][0]=f32::NAN;assert!(!super::host_affine_finite(&frame));
+ }
+}
