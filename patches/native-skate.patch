+// Original host bridge for an already-airborne external locomotion handoff.
+// Use the production lifecycle: an enum write would omit board/skeleton entry.
+pub(crate) fn host_enter_air(physics: &mut GamePhysics, skater: &mut SkaterRuntime) -> Result<(), String> {
+    skater.player_state.selector.teleport_countdown = 0;
+    transition::set(physics, skater, PhysicalStateId::PhysicsAir)?;
+    publish(physics, skater)
+}
+
+// External OoT actor hit uses the same native Enter/Exit ragdoll lifecycle.
+pub(crate) fn host_actor_bail(physics: &mut GamePhysics, skater: &mut SkaterRuntime) -> Result<(), String> {
+    let state = skater.player_state.current();
+    if matches!(
+        state,
+        PhysicalStateId::WipeoutGround
+            | PhysicalStateId::BipedGround
+            | PhysicalStateId::BipedAir
+            | PhysicalStateId::OffBoardPushing
+            | PhysicalStateId::LandingOnDeck
+            | PhysicalStateId::Nonspecific
+            | PhysicalStateId::Sleeping
+            | PhysicalStateId::Teleporting
+    ) {
+        return Ok(());
+    }
+    transition::set(physics, skater, PhysicalStateId::WipeoutGround)?;
+    publish(physics, skater)
+}
