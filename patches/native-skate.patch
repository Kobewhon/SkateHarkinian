+ // Provenance query does not change contact material tags or the solver.
+ pub fn host_actor_contacts(&self)->Vec<[f32;5]>{
+  let mut out=Vec::new();
+  for entry in self.physics.world().contacts(){let c=&entry.contact;let p=c.position_on_b;let n=c.normal;
+   if let Ok(Some(hit))=self.physics.world().query_thin_line(skate_core::math::Vector3::new(p.x+n.x*0.03,p.y+n.y*0.03,p.z+n.z*0.03),skate_core::math::Vector3::new(p.x-n.x*0.03,p.y-n.y*0.03,p.z-n.z*0.03)){let id=(hit.source_id>>16)&0x7fff;
+    if hit.source_id&0x80000000!=0&&(256..512).contains(&id){out.push([id as f32,n.x,n.y,n.z,0.]);}
+   }
+  }out
