+/* Normalize the stock animated color delta around white, preserving cassette art
+ * instead of tinting the entire RGB icon with the stock red IA-heart palette. */
+static void HealthMeter_SetVhsMaterial(PlayState* play, s32 beating, s32 defense) {
+    InterfaceContext* ctx = &play->interfaceCtx;
+    s16 color[3] = { 255, 255, 255 };
+    if (beating) {
+        color[0] +=
+            defense ? sBeatingHeartsDDPrim[0] - sHeartsDDPrim[0][0] : ctx->beatingHeartPrim[0] - ctx->heartsPrimR[0];
+        color[1] +=
+            defense ? sBeatingHeartsDDPrim[1] - sHeartsDDPrim[0][1] : ctx->beatingHeartPrim[1] - ctx->heartsPrimG[0];
+        color[2] +=
+            defense ? sBeatingHeartsDDPrim[2] - sHeartsDDPrim[0][2] : ctx->beatingHeartPrim[2] - ctx->heartsPrimB[0];
+    }
+    OPEN_DISPS(play->state.gfxCtx);
+    gDPPipeSync(OVERLAY_DISP++);
