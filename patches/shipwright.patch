+/* Native locomotion retains the real stock hurtbox, health and OC identity.
+ * Called once per Player actor update, never from an interpolated render frame.
+ * The ordinary AC response uses the same health/iframes/sound helpers below;
+ * OoT knockback locomotion/animation is replaced by native bail presentation. */
+s32 Player_NativeCombatUpdate(PlayState* play, Player* this, f32 impactSpeed) {
+    s32 result = 0;
+    if (((this->meleeWeaponQuads[0].base.atFlags | this->meleeWeaponQuads[1].base.atFlags) & AT_HIT) &&
+        this->heldItemAction >= PLAYER_IA_SWORD_MASTER && this->heldItemAction <= PLAYER_IA_SWORD_BIGGORON) {
+        func_80832630(play);
+        func_80842B7C(play, this); // Stock Giant's Knife durability, once per stock hit.
+    }
+    Collider_ResetQuadAT(play, &this->meleeWeaponQuads[0].base);
+    Collider_ResetQuadAT(play, &this->meleeWeaponQuads[1].base);
+    if (this->bodyShockTimer != 0)
+        Player_UpdateBodyShock(play, this);
+    if (this->bodyIsBurning)
+        Player_UpdateBodyBurn(play, this);
+    if ((this->cylinder.base.acFlags & AC_HIT) && (this->invincibilityTimer == 0) &&
+        !(this->stateFlags1 & PLAYER_STATE1_DEAD) && this->csAction == 0) {
+        Player_PlaySfx(this, NA_SE_PL_DAMAGE);
+        if (this->cylinder.base.ac && (this->cylinder.base.ac->flags & ACTOR_FLAG_SFX_FOR_PLAYER_BODY_HIT)) {
+            Player_PlaySfx(this, NA_SE_PL_BODY_HIT);
+        }
+        func_80838280(this);
+        if (this->actor.colChkInfo.acHitEffect == HIT_SPECIAL_EFFECT_ELECTRIC)
+            this->bodyShockTimer = 40;
+        func_80837B18(play, this, -this->actor.colChkInfo.damage);
+        Player_SetIntangibility(this, 20);
+        Player_PlayVoiceSfx(this, NA_SE_VO_LI_DAMAGE_S);
+        Player_RequestRumble(this, 180, 20, 100, 0);
+        result = 1;
+    }
+    /* OC never invents damage. Category plus incoming relative speed distinguishes
+     * a meaningful hostile-body impact from standing beside an enemy. */
+    if ((this->cylinder.base.ocFlags1 & OC1_HIT) && this->cylinder.base.oc &&
+        (this->cylinder.base.oc->category == ACTORCAT_ENEMY || this->cylinder.base.oc->category == ACTORCAT_BOSS) &&
+        impactSpeed > 0.0f)
+        result |= 2;
+    this->cylinder.base.acFlags &= ~AC_HIT;
+    this->cylinder.base.ac = NULL;
+    this->cylinder.base.ocFlags1 &= ~OC1_HIT;
+    this->cylinder.base.oc = NULL;
+    this->actor.colChkInfo.displacement.x = this->actor.colChkInfo.displacement.y =
+        this->actor.colChkInfo.displacement.z = 0;
+    if (result == 0 || !(result & 1)) {
+        if (this->invincibilityTimer > 0)
+            this->invincibilityTimer--;
+        else if (this->invincibilityTimer < 0)
+            this->invincibilityTimer++;
+    }
+    if (this->unk_A87 > 0)
+        this->unk_A87--;
+    return result;
+}
+/* Native owner publishes a feet-origin position. Keep the stock motion history
+ * coherent: Player_UpdateCommon uses
+ * home.pos as prevPos on its next update. */
+static Player* sNativeSwordOwner;
+static s32 sNativeSwordQueued;
+void Player_NativeHandoff(PlayState* play, Player* this) {
+    sNativeSwordQueued = 0;
+    CollisionPoly* poly = NULL;
+    s32 bgId;
+    Vec3f probe = this->actor.world.pos;
+    probe.y += 10.0f; // Small penetration recovery; do not select an overhead bridge/roof.
+    f32 floor = BgCheck_EntityRaycastFloor5(play, &play->colCtx, &poly, &bgId, &this->actor, &probe);
+    if (poly != NULL && floor > BGCHECK_Y_MIN && floor > this->actor.world.pos.y &&
+        floor - this->actor.world.pos.y <= 10.0f)
+        this->actor.world.pos.y = floor;
+    this->actor.floorPoly = poly;
+    this->actor.floorBgId = bgId;
+    this->actor.floorHeight = floor;
+    this->actor.home.pos = this->actor.prevPos = this->actor.world.pos;
+    this->fallStartHeight = this->actor.world.pos.y;
+    this->fallDistance = 0;
+    this->skelAnime.movementFlags = 0;
+    func_80832318(this);
+    func_80853080(this, play);
+}
+
+/* Same age-specific swimming-entry depth used by func_8083D53C. Negative means
+ * no water; zero means shallow/walkable
+ * water, one means swimming depth. */
+s32 Player_NativeWater(PlayState* play, Player* this) {
+    WaterBox* box;
+    f32 surface = this->actor.world.pos.y;
+    if (!WaterBox_GetSurface1(play, &play->colCtx, this->actor.world.pos.x, this->actor.world.pos.z, &surface, &box) ||
+        surface < this->actor.world.pos.y)
+        return -1;
+    return surface - this->actor.world.pos.y > this->ageProperties->unk_2C;
+}
+s32 Player_NativeSwordDrawn(Player* this) {
+    return this->heldItemAction >= PLAYER_IA_SWORD_MASTER && this->heldItemAction <= PLAYER_IA_SWORD_BIGGORON;
+}
+s32 Player_NativeDryFloor(PlayState* play, Player* this) {
+    CollisionPoly* poly = NULL;
+    s32 bgId;
+    Vec3f probe = this->actor.world.pos;
+    probe.y += 10.0f;
+    f32 floor = BgCheck_EntityRaycastFloor5(play, &play->colCtx, &poly, &bgId, &this->actor, &probe);
+    return poly != NULL && bgId == BGCHECK_SCENE && floor > BGCHECK_Y_MIN &&
+           fabsf(floor - this->actor.world.pos.y) < 20.0f && poly->normal.y > 16384 &&
+           SurfaceType_GetSceneExitIndex(&play->colCtx, poly, bgId) == 0 && Player_NativeWater(play, this) < 0;
+}
+/* Only melee animation, its stock active window and damage configuration run.
+ * No Player_Update, movement action,
+ * root motion, item/cutscene dispatcher. */
+s32 Player_NativeSwordUpdate(PlayState* play, Player* this, s32 attack, s32 offboard, s32 safe) {
+    if (sNativeSwordOwner != this) {
+        sNativeSwordOwner = this;
+        sNativeSwordQueued = 0;
+    }
+    if (!safe) {
+        sNativeSwordQueued = 0;
+        if (this->actionFunc == Player_Action_808502D0) {
+            func_80832318(this);
+            this->skelAnime.movementFlags = 0;
+            func_80853080(this, play);
+        }
+        return 0;
+    }
+    if (attack && offboard && !Player_NativeSwordDrawn(this)) {
+        s8 action = Player_ItemToItemAction(B_BTN_ITEM);
+        if (action >= PLAYER_IA_SWORD_MASTER && action <= PLAYER_IA_SWORD_BIGGORON) {
+            this->nextModelGroup = Player_ActionToModelGroup(this, action);
+            this->heldItemId = B_BTN_ITEM;
+            Player_InitItemActionWithAnim(play, this, action);
+        }
+    }
+    if (attack && Player_NativeSwordDrawn(this) && this->actionFunc != Player_Action_808502D0) {
+        func_80837948(play, this, PLAYER_MWA_FORWARD_SLASH_1H + Player_HoldsTwoHandedWeapon(this));
+        this->skelAnime.movementFlags = 0;
+    } else if (attack && this->actionFunc == Player_Action_808502D0)
+        sNativeSwordQueued = 1;
+    if (this->actionFunc == Player_Action_808502D0) {
+        struct_80854190* melee = &D_80854190[this->meleeWeaponAnimation];
+        func_8084285C(this, 0.0f, melee->unk_0C, melee->unk_0D);
+        if (LinkAnimation_Update(play, &this->skelAnime)) {
+            if (sNativeSwordQueued && Player_NativeSwordDrawn(this)) {
+                sNativeSwordQueued = 0;
+                func_80837948(play, this, PLAYER_MWA_FORWARD_SLASH_1H + Player_HoldsTwoHandedWeapon(this));
+                this->skelAnime.movementFlags = 0;
+                return 1;
+            }
+            func_80832318(this);
+            func_80853080(this, play);
+            this->skelAnime.movementFlags = 0;
+            return 0;
+        }
+        return 1;
+    }
+    return 0;
+}
+void Player_NativeRegisterColliders(PlayState* play, Player* this) {
+    f32 delta = this->actor.world.pos.y - this->actor.prevPos.y;
+    f32 feet =
+        (this->bodyPartsPos[PLAYER_BODYPART_L_FOOT].y + this->bodyPartsPos[PLAYER_BODYPART_R_FOOT].y) * 0.5f + delta;
+    f32 top = this->bodyPartsPos[PLAYER_BODYPART_HEAD].y + 10.0f + delta;
+    f32 height = top - feet;
+    if (height < 0) {
+        feet = top;
+        height = -height;
+    }
+    /* Draw callbacks refresh these same real Player body points. First update
+     * before a draw uses the actual age-dependent stock Player height. */
+    if (!isfinite(height) || height < 10.0f || height > 150.0f) {
+        feet = this->actor.world.pos.y;
+        height = Player_GetHeight(this);
+    }
+    this->cylinder.dim.height = height;
+    this->cylinder.dim.yShift = feet - this->actor.world.pos.y;
+    Collider_UpdateCylinder(&this->actor, &this->cylinder);
+    if (!(this->stateFlags1 & PLAYER_STATE1_DEAD)) {
+        CollisionCheck_SetOC(play, &play->colChkCtx, &this->cylinder.base);
+        if (this->invincibilityTimer <= 0)
+            CollisionCheck_SetAC(play, &play->colChkCtx, &this->cylinder.base);
+    }
+}
