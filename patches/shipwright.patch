+// NativeSkating world-interaction slice. Called only by the native owner.
+// Query metadata only: no Actor_UpdateBgCheckInfo, velocity integration,
+// wall resolution, ceiling correction or ordinary Player_Update.
+s32 Player_UpdateNativeWorldInteractions(PlayState* play, Player* this, s32 grounded) {
+    CollisionPoly* poly = NULL;
+    s32 bgId = BGCHECK_SCENE;
+    Vec3f probe = this->actor.world.pos;
+    probe.y = MAX(this->actor.prevPos.y, probe.y) + 50.0f; // Stock floor query reach, metadata only.
+    this->actor.floorHeight = BgCheck_EntityRaycastFloor5(play, &play->colCtx, &poly, &bgId, &this->actor, &probe);
+    this->actor.floorPoly = poly;
+    this->actor.floorBgId = bgId;
+    sYDistToFloor = this->actor.world.pos.y - this->actor.floorHeight;
+    sConveyorSpeed = 0;
+    sFloorType = poly ? SurfaceType_GetFloorType(&play->colCtx, poly, bgId) : 0;
+    this->floorProperty = poly ? func_80041EA4(&play->colCtx, poly, bgId) : 0;
+    if (grounded)
+        this->actor.bgCheckFlags |= BGCHECKFLAG_GROUND;
+    else
+        this->actor.bgCheckFlags &= ~BGCHECKFLAG_GROUND;
+    if (Player_HandleExitsAndVoids(play, this, poly, bgId))
+        return 1;
+    // Native skating can cross an entire exit strip between host frames.
+    // Query stock scene floor metadata along that movement, then let the stock
+    // exit handler select entrance/rando/voidout semantics. Never move the actor.
+    if (grounded && play->setupExitList != NULL) {
+        f32 dx = this->actor.world.pos.x - this->actor.prevPos.x;
+        f32 dz = this->actor.world.pos.z - this->actor.prevPos.z;
+        f32 distance = sqrtf(dx * dx + dz * dz);
+        if (isfinite(distance) && distance > 8.0f && distance < 500.0f) {
+            s32 steps = (s32)ceilf(distance / 8.0f);
+            s32 i;
+            for (i = 1; i < steps; ++i) {
+                f32 t = (f32)i / steps;
+                CollisionPoly* crossing = NULL;
+                s32 crossingBg = BGCHECK_SCENE;
+                Vec3f point = { this->actor.prevPos.x + dx * t,
+                                MAX(this->actor.prevPos.y, this->actor.world.pos.y) + 50.0f,
+                                this->actor.prevPos.z + dz * t };
+                f32 height =
+                    BgCheck_EntityRaycastFloor5(play, &play->colCtx, &crossing, &crossingBg, &this->actor, &point);
+                if (crossing != NULL && SurfaceType_GetSceneExitIndex(&play->colCtx, crossing, crossingBg) != 0 &&
+                    fabsf(this->actor.world.pos.y - height) < 100.0f &&
+                    Player_HandleExitsAndVoids(play, this, crossing, crossingBg))
+                    return 1;
+            }
+        }
+    }
+    // Door actors retain their stock proximity/key/room checks. The standard
+    // action handler starts the stock door animation only on the normal A edge.
+    sControlInput = &play->state.input[0];
+    if (this->doorType != PLAYER_DOORTYPE_NONE && Player_ActionHandler_1(this, play))
+        return 2;
+    return 0;
+}
